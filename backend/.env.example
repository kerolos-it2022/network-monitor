PORT=4000
SESSION_SECRET=change-this-to-a-random-long-string
DB_PATH=../database/monitoring.db

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (اختياري - عبر مزود مثل Twilio أو WhatsApp Cloud API)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_TO_NUMBER=

# إشعارات الموبايل (PWA + Web Push عبر VAPID)
# مفاتيح VAPID تُولَّد تلقائياً عند تشغيل deploy.sh install
# أو يدوياً: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
MOBILE_ENABLED=1

# ─────────────────────────────────────────────────────────────
# إعدادات التحديثات من GitHub (GitHub Updates)
# ─────────────────────────────────────────────────────────────
# رابط المستودع — يُقرأ فعلياً من الكود لدعم الـ forks والمستودعات الخاصة.
# مثال: https://github.com/kerolos-it2022/network-monitor.git
GITHUB_REPO_URL=https://github.com/kerolos-it2022/network-monitor.git

# الفرع الافتراضي للتحديثات (يُستخدم كـ fallback عند تعذّر اكتشاف الفرع تلقائياً)
GITHUB_BRANCH=main

# GitHub Personal Access Token (اختياري):
#   - مطلوب للمستودعات الخاصة (بدونه سيفشل طلب releases API).
#   - اختياري للمستودعات العامة، لكنه يرفع حد API من 60 إلى 5000 طلب/ساعة.
# إنشاء من: https://github.com/settings/tokens  (صلاحية: repo للخاص، public_repo للعام)
GITHUB_TOKEN=

# حساب المدير الافتراضي (يُستخدم فقط في أول تشغيل لإنشاء المستخدم)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ─────────────────────────────────────────────────────────────
# SpaceKit Phase 0 — SEC-01: أدوات التشخيص (Ping/Tracert)
# ─────────────────────────────────────────────────────────────
# أدنى رتبة مسموح لها باستخدام أدوات التشخيص: admin (افتراضي) أو viewer.
# قرار المالك: أي مستخدم مسجَّل (مدير أو عرض) يستطيع استخدام أدوات التشخيص — والمجهول ممنوع (401).
NM_TOOLS_MIN_ROLE=viewer
# النطاقات المسموح بفحصها (CIDR مفصولة بفواصل). اتركه فارغًا ⇒ الخاص فقط:
# 10/8, 172.16/12, 192.168/16, 127/8, 169.254/16, 100.64/10 + IPv6: fc00::/7, fe80::/10, ::1
NM_TOOLS_ALLOWED_CIDRS=
# السماح بفحص عناوين عامة (خطر أمني — اتركه 0 إلا لضرورة مبرَّرة)
# قرار المالك: السماح بأهداف عامة (مثل 8.8.8.8) **للمستخدمين المسجَّلين فقط**.
# الجهاز ما زال محميًا بـ: تسجيل دخول + حدود تكرار/تزامن/زمن/مخرجات + بلا shell.
NM_TOOLS_ALLOW_PUBLIC=1
# حدود التشغيل: باكيتات ping، أقصى قفزات tracert، حد التزامن، وحد الطلبات/دقيقة لكل مستخدم
NM_PING_COUNT=4
NM_TRACERT_MAX_HOPS=15
NM_TOOLS_MAX_CONCURRENT=2
NM_TOOLS_RATE_PER_MIN=10
NM_TOOLS_MAX_OUTPUT_LINES=400
NM_TOOLS_MAX_OUTPUT_BYTES=65536

# ─────────────────────────────────────────────────────────────
# SpaceKit Phase 0 — SEC-03: جلسات/CSRF/بروكسي/بذرة الأدمن
# ─────────────────────────────────────────────────────────────
# ثقة البروكسي (ngrok/nginx): اتركه فارغًا لبلا ثقة بأي X-Forwarded-*.
# القيم المقبولة مثل: 1 | loopback | linklocal | 10.0.0.0/8 ... (تمرَّر كما هي لـ Express)
NM_TRUST_PROXY=
# حماية CSRF بالتحقق من الأصل: 1=مفعّلة (افتراضي) · 0=إيقاف طارئ (غير موصى به)
NM_CSRF_GUARD=1
# أصول إضافية مسموح بها (مفصولة بفواصل) — للفصل بين نطاق ngrok وواجهة داخلية
NM_ALLOWED_ORIGINS=
# السماح المؤقت بكلمة مرور مدير ضعيفة في الإنتاج (غير موصى به — للطوارئ فقط)
NM_ALLOW_WEAK_ADMIN=0

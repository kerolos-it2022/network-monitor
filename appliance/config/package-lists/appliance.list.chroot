# إدارة عن بعد (SSH) + صلاحيات sudo لمستخدم sysadmin
openssh-server
sudo

# خادم الويب العكسي + تشغيل المشروع
nginx
# ملاحظة OPS-01 (SpaceKit): nodejs/npm يُثبَّتان من NodeSource (Node 24 LTS) عبر الـ hook
# رقم 0050-install-nodejs.hook.chroot — لأن حزمة دبيان 12 الافتراضية هي Node 18
# والمشروع صار يشترط Node ≥22 (better-sqlite3@13). أُزيلا من هذه القائمة عمدًا.

# أدوات شبكة يستعملها المشروع (فحص ping/traceroute/DNS)

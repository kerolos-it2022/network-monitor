#!/bin/sh
# 0990-fix-grub-paths.hook.binary — v2.7.5
# التنفيذ: live-build يشغّل الـ hook بـ `cd binary && ../config/hooks/...`
# أي أن cwd عند الدخول = مجلد binary/ نفسه.
# المهام (بعد binary_linux-images و binary_grub_cfg وقبل binary_iso):
#   1) اختيار أحدث نواة في binary/live لديها /lib/modules في chroot
#      (bookworm قد يترك نواة بلا وحدات — modprobe ext4 يفشل معها داخل النظام الحي)
#   2) تَرقيع grub.cfg للمسارات المُسَنَّسَنة الصحيحة
#   3) إنشاء روابط /live/vmlinuz و /live/initrd.img احتياطًا
set -e

cd live 2>/dev/null || exit 0

# 1) اختيار النواة: الأحدث أولاً، بشرط وجود وحداتها في chroot.
KVER=""
for VK in $(ls -1 vmlinuz-* 2>/dev/null | sed 's/^vmlinuz-//' | sort -Vr); do
  if [ -d "../../chroot/lib/modules/$VK" ]; then
    KVER="$VK"
    break
  fi
done
# fallback: أحدث نواة متاحة (لن يحدث مع 0130-prune-kernels).
[ -n "$KVER" ] || KVER=$(ls -1 vmlinuz-* 2>/dev/null | sed 's/^vmlinuz-//' | sort -V | tail -1)
[ -n "$KVER" ] || exit 0

cd ..

# 2) تَرقيع grub.cfg (idempotent).
sed -i \
  -e "s|/live/vmlinuz |/live/vmlinuz-${KVER} |" \
  -e "s|/live/initrd.img$|/live/initrd.img-${KVER}|" \
  boot/grub/grub.cfg

# 3) روابط احتياطية داخل binary/live (cwd الحالي بعد cd .. هو binary/).
ln -sf "vmlinuz-${KVER}" live/vmlinuz
ln -sf "initrd.img-${KVER}" live/initrd.img

echo "[nm-hook] grub.cfg -> kernel ${KVER} (modules verified)"

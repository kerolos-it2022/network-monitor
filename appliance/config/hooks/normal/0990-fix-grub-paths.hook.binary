#!/bin/sh
# 0990-fix-grub-paths.hook.binary — v2.7.5
# ملاحظة: live-build (bookworm) يشغّل الـ .hook.binary من config/hooks/normal/
# و config/hooks/live/ فقط، والـ cwd عند التنفيذ هو مجلد binary/ نفسه.
# المشكلة: في وضع grub-pc BIOS لا تُنشَأ روابط /live/vmlinuz غير المُسَنَّسَنة،
# وقد تحتوي الصورة نواتين إحداهما بلا وحدات — قائمتنا يجب أن تقبل نواة
# لديها /lib/modules في chroot وإلا فشل modprobe (مثل ext4) داخل النظام الحي.
# الـ hook يعمل بعد binary_linux-images و binary_grub_cfg وقبل binary_iso:
#   1) يختار أحدث نواة موجودة لها وحدات في chroot/lib/modules
#   2) يُحدّث grub.cfg للمسارات المُسَنَّسَنة الصحيحة
#   3) ينشئ الروابط غير المُسَنَّسَنة احتياطًا
set -e

KVER=""
for VK in $(ls -1 binary/live/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||' | sort -Vr); do
  if [ -d "chroot/lib/modules/$VK" ]; then
    KVER="$VK"
    break
  fi
done
# fallback: أحدث نواة لو لم نجد تطابقًا (لن يحدث مع 0130-prune-kernels).
[ -n "$KVER" ] || KVER=$(ls -1 binary/live/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||' | sort -V | tail -1)
[ -n "$KVER" ] || exit 0

sed -i \
  -e "s|/live/vmlinuz |/live/vmlinuz-${KVER} |" \
  -e "s|/live/initrd.img$|/live/initrd.img-${KVER}|" \
  binary/boot/grub/grub.cfg

ln -sf "vmlinuz-${KVER}" binary/live/vmlinuz
ln -sf "initrd.img-${KVER}" binary/live/initrd.img

echo "[nm-hook] grub.cfg -> kernel ${KVER} (modules verified)"

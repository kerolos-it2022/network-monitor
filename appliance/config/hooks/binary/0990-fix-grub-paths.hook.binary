#!/bin/sh
# 0990-fix-grub-paths.hook.binary — v2.7.5
# في وضع grub-pc BIOS لا تُنشئ live-build روابط /live/vmlinuz و /live/initrd.img
# غير المُسَنَّسَنة (ذلك عمل binary_syslinux الذي لم نعد نستخدمه) — وقائمتنا
# الموسومة تشير إليها → GRUB يفشل "file not found" → شاشة سوداء.
# هذا الـ hook يعمل بعد binary_linux-images و binary_grub_cfg وقبل binary_iso:
#   1) يكتشف أحدث نواة (vmlinuz-*) في binary/live
#   2) يُحدّث grub.cfg للمسارات المُسَنَّسَنة الصحيحة
#   3) ينشئ الروابط غير المُسَنَّسَنة احتياطًا
set -e

cd binary/live 2>/dev/null || exit 0
KVER=$(ls -1 vmlinuz-* 2>/dev/null | sed 's/^vmlinuz-//' | sort -V | tail -1)
[ -n "$KVER" ] || exit 0
cd ../..

# 1+2) تحديث grub.cfg للمسارات المُسَنَّسَنة (idempotent).
sed -i \
  -e "s|/live/vmlinuz |/live/vmlinuz-${KVER} |" \
  -e "s|/live/initrd.img$|/live/initrd.img-${KVER}|" \
  binary/boot/grub/grub.cfg

# 3) روابط احتياطية للتوافق.
ln -sf "vmlinuz-${KVER}" binary/live/vmlinuz
ln -sf "initrd.img-${KVER}" binary/live/initrd.img

echo "[nm-hook] grub.cfg → kernel ${KVER}"

#!/bin/sh
# 0110-enable-services.hook.chroot — تفعيل الخدمات داخل النظام المبني.
set -e

# خدمة المشروع + الكونسول + nginx + جدار nftables + SSH
systemctl enable network-monitor.service 2>/dev/null || true
systemctl enable nm-console.service 2>/dev/null || true
systemctl enable nginx 2>/dev/null || true
systemctl enable nftables 2>/dev/null || true
systemctl enable ssh 2>/dev/null || true
# v2.8.7 — مُراقِب طلبات التحديث (ينطلق المساعد root عند ظهور ملف الطلب).
systemctl enable nm-update.path 2>/dev/null || true
# v2.9.0 — مُراقِب طلبات «الوصول عن بُعد» (ngrok): مساعد root منفصل بنفس النمط.
systemctl enable nm-remote.path 2>/dev/null || true

# تفعيل موقع nginx الخاص بالمشروع وتعطيل الافتراضي.
if [ -d /etc/nginx/sites-enabled ]; then
  ln -sf /etc/nginx/sites-available/network-monitor /etc/nginx/sites-enabled/network-monitor
  rm -f /etc/nginx/sites-enabled/default
fi

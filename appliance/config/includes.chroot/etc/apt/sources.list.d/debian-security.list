# Official Debian 12 (bookworm) security repository — correct 2021+ suite format.
# live-build on Ubuntu runners emits the old style (bookworm/updates) which 404s,
# so it is disabled (--security false) and re-added here in the correct form —
# it persists in the live and installed systems and covers security updates.
deb http://security.debian.org/debian-security bookworm-security main

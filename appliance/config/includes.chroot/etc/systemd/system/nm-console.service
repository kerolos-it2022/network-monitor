[Unit]
Description=Network Monitor Appliance — console menu (tty1)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
# Stop getty@tty1 while the menu runs (auto-restarts if the service dies).
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
ExecStart=/usr/local/sbin/nm-console
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVTDisallocate=no
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target

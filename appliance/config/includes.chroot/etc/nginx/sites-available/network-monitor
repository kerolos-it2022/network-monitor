# nginx site — network-monitor appliance: 80 -> 127.0.0.1:4001.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # v2.8.7 — رُفع من 50m إلى 300m: استعادة النسخة الاحتياطية ترفع ملف القاعدة كاملاً
    # (المشروع ينمو مع السجلات) — وكان الحدّ يمنع الاستعادة لملفات كبيرة.
    client_max_body_size 300m;

    location / {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Network tools (SSE / long-lived streams) — no buffering, long read timeout.
    location /api/tools/ {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # v2.8.7 — البثّ الحيّ لحالة الأجهزة (SSE): /api/live/status — بلا buffering ومهلة طويلة،
    # وإلّا يخزّن nginx الأحداث فلا تصل لحظيًّا للشاشات.
    location /api/live/ {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

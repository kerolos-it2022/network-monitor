#!/bin/bash
# nm-remote — تنفيذ أوامر «الوصول عن بُعد» (ngrok) نيابةً عن خدمة الويب (root، عبر nm-remote.path → nm-remote.service).
# ─────────────────────────────────────────────────────────────────────────────
# نموذج الأمان (مطابق لـ nm-update — الجهاز قد يكون مكشوفًا على الإنترنت عبر ngrok):
#   • لا تستقبل الأداة أي أمر من خدمة الويب: تقرأ **ملف طلب واحد** يسمح بخمسة أفعال ثابتة فقط:
#       start | stop | restart | autostart-on | autostart-off
#     وأي قيمة أخرى ⇒ رفض بلا أي تنفيذ (قائمة بيضاء صارمة).
#   • لا sourcing ولا eval ولا تنفيذ لنصّ من الملف؛ الفعل يُستخرَج بـ sed ثم يُقارن بالقائمة.
#   • ملفات الحالة/السجل تُكتب داخل مجلد مملوك لـ root بكتابة ذرّية (mv) — لا روابط رمزية.
#   • **لا تُقرأ قيمة التوكن ولا تُطبع ولا تُنسخ**: يُفحَص وجود الملف فقط (/root/.config/ngrok/ngrok.yml).
#   • النفق يعمل دائمًا كوحدة systemd مستقلّة (ngrok-tunnel.service) حتى لا يُقتل مع انتهاء هذا المساعد.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

DATA_DIR="/var/lib/network-monitor"
REQ_FILE="$DATA_DIR/remote-request.json"      # يكتبه netmon (مدخل غير موثوق ⇒ تحقّق صارم)
STATE_DIR="$DATA_DIR/remote"                  # مملوك لـ root
STATUS_FILE="$STATE_DIR/status.json"
LOG_FILE="$STATE_DIR/remote.log"
TMP_ROOT="$STATE_DIR/tmp"
NGROK_BIN="/usr/local/bin/ngrok"
DOMAIN_FILE="/etc/nm-ngrok-domain"
NGROK_LOG="/var/log/ngrok.log"
UNIT="ngrok-tunnel.service"
UNIT_PATH="/etc/systemd/system/$UNIT"
TOKEN_FILE="/root/.config/ngrok/ngrok.yml"

install -d -o root -g root -m 0755 "$STATE_DIR"
install -d -o root -g root -m 0700 "$TMP_ROOT"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"; }
token_state() { [ -f "$TOKEN_FILE" ] && echo "set" || echo "not_set"; }
domain_of() { head -1 "$DOMAIN_FILE" 2>/dev/null || true; }
tunnel_pid() { pgrep -f "$NGROK_BIN http" 2>/dev/null | head -1; }

status() { # state action message authtoken
  local t="$TMP_ROOT/.status.$$"
  printf '{"state":"%s","action":"%s","message":"%s","authtoken":"%s","at":"%s"}\n' \
    "$1" "${2:-}" "${3:-}" "$(token_state)" "$(date -Iseconds)" > "$t"
  chmod 644 "$t" 2>/dev/null || true
  mv -f "$t" "$STATUS_FILE"
}
fail() { log "FAILED: ${ACTION:-?} — $1"; status failed "${ACTION:-}" "$1"; rm -f "$REQ_FILE"; exit 1; }

[ -f "$REQ_FILE" ] || { log "لا يوجد ملف طلب — إنهاء."; exit 0; }

# ── قراءة الفعل ثم حذف ملف الطلب فورًا (منع التكرار) ──
ACTION="$(sed -n 's/.*"action"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$REQ_FILE" | head -n1)"
rm -f "$REQ_FILE"
[ -n "$ACTION" ] || fail "ملف الطلب لا يحوي فعلًا صالحًا"
case "$ACTION" in
  start|stop|restart|autostart-on|autostart-off) ;;
  *) fail "فعل غير مسموح: $ACTION" ;;
esac

log "=== طلب: $ACTION (الحالي: pid $(tunnel_pid || echo -) · توكن: $(token_state)) ==="
status in_progress "$ACTION" "جارٍ التنفيذ…"

# ── كتابة وحدة التشغيل (بالدومين الثابت الحالي) ──
write_unit() {
  local D; D="$(domain_of)"
  cat > "$UNIT_PATH" <<EOF
[Unit]
Description=ngrok tunnel for Network Monitor web UI
After=network-online.target nginx.service
Wants=network-online.target

[Service]
ExecStart=$NGROK_BIN http 80${D:+ --domain=$D}
Restart=on-failure
RestartSec=5
# سجل readable للتطبيق (لوحة التحكم تعرض آخر السطور بلا أي توكن)
StandardOutput=append:$NGROK_LOG
StandardError=append:$NGROK_LOG

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

start_tunnel() {
  [ -x "$NGROK_BIN" ] || return 2
  [ "$(token_state)" = "set" ] || return 3
  # سجل كبير؟ نقتطعه عند كل تشغيل (بلا تدوير معقّد)
  if [ -f "$NGROK_LOG" ] && [ "$(stat -c %s "$NGROK_LOG" 2>/dev/null || echo 0)" -gt 2097152 ]; then
    : > "$NGROK_LOG" 2>/dev/null || true
  fi
  write_unit
  systemctl start "$UNIT" 2>/dev/null || return 1
  sleep 4
  [ -n "$(tunnel_pid)" ] && return 0
  return 1
}

stop_tunnel() {
  systemctl stop "$UNIT" 2>/dev/null || true
  pkill -f "$NGROK_BIN http" 2>/dev/null || true
  sleep 1
  return 0
}

case "$ACTION" in
  start)
    if [ -n "$(tunnel_pid)" ]; then status success start "النفق يعمل بالفعل — لا حاجة لتشغيله"; exit 0; fi
    start_tunnel; RC=$?
    case "$RC" in
      0) : ;;
      2) fail "ngrok غير مثبّت على الجهاز (ثبّته من كونسول الجهاز)" ;;
      3) fail "التوكن (authtoken) غير مضبوط — اضبطه من كونسول الجهاز: Remote access → [2]" ;;
      *) fail "تعذّر تشغيل النفق — راجع: journalctl -u $UNIT -n 30" ;;
    esac
    ;;
  stop) stop_tunnel ;;
  restart)
    stop_tunnel
    start_tunnel; RC=$?
    [ "$RC" = "0" ] || fail "تعذّر إعادة تشغيل النفق (رمز $RC)"
    ;;
  autostart-on)
    [ -x "$NGROK_BIN" ] || fail "ngrok غير مثبّت على الجهاز"
    [ "$(token_state)" = "set" ] || fail "التوكن (authtoken) غير مضبوط — اضبطه من كونسول الجهاز أولًا"
    write_unit
    systemctl enable "$UNIT" >/dev/null 2>&1 || fail "تعذّر تفعيل التشغيل التلقائي"
    systemctl restart "$UNIT" 2>/dev/null || true
    sleep 3
    [ -n "$(tunnel_pid)" ] || fail "تم التفعيل لكن النفق لم يعمل — راجع السجل"
    ;;
  autostart-off)
    systemctl disable "$UNIT" >/dev/null 2>&1 || true
    stop_tunnel
    ;;
esac

# ── الحالة النهائية ──
if [ -n "$(tunnel_pid)" ]; then
  case "$ACTION" in
    start)        status success start        "تم تشغيل النفق ✓" ;;
    restart)      status success restart      "تمت إعادة تشغيل النفق ✓" ;;
    autostart-on) status success autostart-on "تم تفعيل التشغيل التلقائي عند الإقلاع ✓" ;;
    *)            status success "$ACTION"    "تم التنفيذ — النفق يعمل" ;;
  esac
else
  case "$ACTION" in
    stop)         status success stop          "تم إيقاف النفق ✓" ;;
    autostart-off)status success autostart-off "تم تعطيل التشغيل التلقائي وإيقاف النفق ✓" ;;
    *)            fail "النفق لا يعمل بعد التنفيذ — راجع: journalctl -u $UNIT -n 30" ;;
  esac
fi
exit 0

#!/bin/sh
# nm-sync-console-password — مصدر واحد لكلمة مرور «أبواب» الأبلاينس:
#   (1) شاشة الكونسول على tty1            → /etc/nm-console.conf   (SHA-512، ملف 600)
#   (2) الدخول على لينكس (SSH/تيرمنال)     → كلمة مرور مستخدم السودو (sysadmin)
#
# لماذا هذا الملف؟ لأن اللوحة (تغيير كلمة المرور من الملف الشخصي) كانت تُحدِّث قاعدة البيانات
# وحدها، فتبقى شاشة الكونسول ودخول لينكس على الكلمة القديمة ⇒ بابان مختلفان لكلمة واحدة.
#
# مبادئ التصميم:
#   · لا يلمس قاعدة بيانات التطبيق — التطبيق (netmon) يحدّثها بنفسه ⇒ root لا يكتب بياناتك.
#   · كلمة المرور تُقرأ من **stdin** لا من وسائط argv (كي لا تظهر أبدًا في ps أو في سجلّ الأوامر).
#   · سطر واحد فقط ويُتجاهل CR (قد يأتي النصّ من ملف/ويندوز).
#   · لا يُنفَّذ إلا بـroot، ولا يعرف سوى هذا العمل الواحد (وفق قاعدة sudoers المرفقة).
#
# الاستعمال:  printf '%s\n' "$PASSWORD" | nm-sync-console-password
set -eu

LINUX_ADMIN_USER="${NM_LINUX_ADMIN_USER:-sysadmin}"
MIN_LEN=4
CONF=/etc/nm-console.conf

[ "$(id -u)" -eq 0 ] || { echo "nm-sync-console-password: must run as root" >&2; exit 1; }

# كل ما وصل على stdin، ثم أول سطر فقط بلا CR/سطر فارغ
PW=$(cat)
PW=$(printf '%s' "$PW" | tr -d '\r' | head -n1)
[ -n "$PW" ] || { echo "nm-sync-console-password: empty password on stdin" >&2; exit 2; }
if [ "${#PW}" -lt "$MIN_LEN" ]; then
  echo "nm-sync-console-password: password too short (min $MIN_LEN)" >&2
  exit 2
fi

# (1) بوابة شاشة الكونسول
umask 077
printf 'CONSOLE_HASH=%s\n' "$(printf '%s' "$PW" | sha512sum | cut -d' ' -f1)" > "$CONF"
chmod 600 "$CONF"

# (2) حساب لينكس (نفس الباسورد لـSSH وما بعده من tty)
if getent passwd "$LINUX_ADMIN_USER" >/dev/null 2>&1; then
  printf '%s:%s\n' "$LINUX_ADMIN_USER" "$PW" | chpasswd
  echo "nm-sync-console-password: console gate + Linux login of '$LINUX_ADMIN_USER' updated."
else
  echo "nm-sync-console-password: console gate updated ('$LINUX_ADMIN_USER' account not present)."
fi

logger -t nm-sync-console-password "admin password synced (console gate + $LINUX_ADMIN_USER)" 2>/dev/null || true
exit 0

#!/bin/bash
# ═══════════════════════════════════════════════════════════════════
# nm-install-to-disk — appliance installer: copies the live system to a
# local disk, installs GRUB, generates secrets (Sophos-style flow).
# English UI: the Linux console cannot render Arabic.
# ═══════════════════════════════════════════════════════════════════
# WARNING: erases the target disk entirely. Requires typed confirmation "YES".
set -euo pipefail

LOG=/var/log/nm-install.log
MOUNT=/mnt/nm-install
MARKER=/etc/nm-installed

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*"; }
die()   { printf '\033[31mERROR: %s\033[0m\n' "$*" >&2; pause_fail; exit 1; }

# Log everything to a file; on failure show the last lines on screen and wait
# (otherwise systemd restarts the menu instantly and the error is invisible).
exec > >(tee -a "$LOG") 2>&1
trap 'echo; echo "═══ INSTALL FAILED ═══"; echo "── last log lines:"; tail -15 "$LOG"; echo; read -r -p "Press ENTER to return to menu…" _; exit 1' ERR
pause_fail() { read -r -p "Press ENTER…" _; }

# Validate an IPv4 dotted quad (each octet 0-255).
valid_ipv4() {
  local ip="$1"
  [[ "$ip" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
  local IFS=.
  set -- $ip
  local o
  for o in "$@"; do [ "$((10#$o))" -le 255 ] || return 1; done
  return 0
}

# Convert a CIDR prefix (8-32) to a dotted netmask.
prefix2mask() {
  local p="$1" m="" i o
  for i in 1 2 3 4; do
    if [ "$p" -ge 8 ]; then o=255; p=$((p - 8)); else o=$((256 - (1 << (8 - p)))); p=0; fi
    m="$m$o"
    [ "$i" -lt 4 ] && m="$m."
  done
  echo "$m"
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ -f "$MARKER" ] && die "system already installed on this machine."

# ── list candidate disks (TYPE=disk only — excludes floppy/loop/rom) ──
echo
bold "═══ Network Monitor Appliance — Installer ═══"
echo
echo "Available disks:"
lsblk -e 2,7,11 -dno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk" {printf "  /dev/%-8s %8s  %s\n", $1, $2, $3}'
echo

read -r -p "Type the target disk name (e.g. sda): " DISK_NAME
DISK="/dev/$DISK_NAME"
[ -b "$DISK" ] || die "disk $DISK not found."
lsblk -e 2,7,11 -dno TYPE "/dev/$DISK_NAME" | grep -qx "disk" || die "$DISK is not a whole disk."

SIZE=$(lsblk -dno SIZE "/dev/$DISK_NAME" | head -1)
MODEL=$(lsblk -dno MODEL "/dev/$DISK_NAME" | head -1)
echo
warn "═══ FINAL WARNING ═══"
warn "ALL DATA on $DISK ($SIZE — $MODEL) will be ERASED."
read -r -p "Type YES to confirm: " CONFIRM
# Accept YES in any case, ignoring whitespace — still an explicit typed confirmation.
CONFIRM_UP=$(printf '%s' "$CONFIRM" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
if [ "$CONFIRM_UP" != "YES" ]; then
  die "installation cancelled (received: '$CONFIRM')"
fi

# ── network configuration (DHCP default — Enter passes through) ──
echo
echo "── Network configuration ──"
echo "  [1] DHCP — automatic (default)"
echo "  [2] Static IP"
NET_MODE=dhcp
read -r -p "Select [1]: " NET_SEL
NET_SEL=${NET_SEL:-1}
if [ "$NET_SEL" = "2" ]; then
  NET_MODE=static
  read -r -p "  IP address (e.g. 192.168.1.50): " NET_IP
  until valid_ipv4 "$NET_IP"; do read -r -p "  Invalid IP — try again: " NET_IP; done
  read -r -p "  Subnet prefix (8-32, default 24): " NET_PREFIX
  NET_PREFIX=${NET_PREFIX:-24}
  case "$NET_PREFIX" in ''|*[!0-9]*) NET_PREFIX=24 ;; esac
  [ "$NET_PREFIX" -ge 8 ] 2>/dev/null && [ "$NET_PREFIX" -le 32 ] 2>/dev/null || NET_PREFIX=24
  read -r -p "  Default gateway: " NET_GW
  until valid_ipv4 "$NET_GW"; do read -r -p "  Invalid gateway — try again: " NET_GW; done
  read -r -p "  DNS server [$NET_GW]: " NET_DNS
  NET_DNS=${NET_DNS:-$NET_GW}
  until valid_ipv4 "$NET_DNS"; do read -r -p "  Invalid DNS — try again: " NET_DNS; done
  echo "  Static: $NET_IP/$NET_PREFIX via $NET_GW (DNS $NET_DNS)"
else
  echo "  DHCP will configure the network automatically."
fi

# ── partition (GPT — supports BIOS and UEFI) ──
echo "── Partitioning…"
umount -R "$MOUNT" 2>/dev/null || true
for p in "$DISK"?*; do umount "$p" 2>/dev/null || true; done
swapoff -a 2>/dev/null || true
wipefs -a "$DISK" >/dev/null 2>&1 || true

IS_UEFI=no
[ -d /sys/firmware/efi ] && IS_UEFI=yes

parted -s "$DISK" mklabel gpt
if [ "$IS_UEFI" = yes ]; then
  parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
  parted -s "$DISK" set 1 esp on
  parted -s "$DISK" mkpart root ext4 513MiB 100%
  ESP="$DISK"1
  ROOT="$DISK"2
  mkfs.vfat -F32 "$ESP" >/dev/null
else
  parted -s "$DISK" mkpart bios_grub 1MiB 2MiB
  parted -s "$DISK" set 1 bios_grub on
  parted -s "$DISK" mkpart root ext4 2MiB 100%
  ROOT="$DISK"2
fi
mkfs.ext4 -F -L nmroot "$ROOT" >/dev/null

# ── copy the system ──
echo "── Copying system to disk (may take a few minutes)…"
mkdir -p "$MOUNT"
mount "$ROOT" "$MOUNT"
[ "$IS_UEFI" = yes ] && { mkdir -p "$MOUNT/boot/efi"; mount "$ESP" "$MOUNT/boot/efi"; }

# tolerate rsync "vanished files" (24) / partial attr errors (23) — normal on a
# running live rootfs; anything else aborts via trap.
rsync -aHAX \
  --exclude=/dev --exclude=/proc --exclude=/sys --exclude=/run \
  --exclude=/live --exclude=/media --exclude=/mnt --exclude=/tmp \
  --exclude=/swapfile --exclude=/etc/nm-installed --exclude=/var/log \
  / "$MOUNT/" || RSC=$?
RSC=${RSC:-0}
if [ "$RSC" -ne 0 ] && [ "$RSC" -ne 23 ] && [ "$RSC" -ne 24 ]; then
  die "rsync failed with exit code $RSC"
elif [ "$RSC" -ne 0 ]; then
  echo "   (rsync finished with minor transfer notices, code $RSC — continuing)"
fi
# rsync excludes tmpfs/kernel-mounted dirs and /var/log — the installed root
# still needs those mount-point directories to exist (systemd requires /run).
mkdir -p "$MOUNT"/{dev,proc,sys,run,tmp,media,mnt,var/log,var/log/nginx}
chmod 1777 "$MOUNT/tmp"

# ── chroot prep ──
mount --bind /dev  "$MOUNT/dev"
mount --bind /proc "$MOUNT/proc"
mount --bind /sys  "$MOUNT/sys"
mount --bind /run  "$MOUNT/run"

# ── fstab from real UUIDs ──
ROOT_UUID=$(blkid -s UUID -o value "$ROOT")
{
  echo "UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1"
  [ "$IS_UEFI" = yes ] && echo "UUID=$(blkid -s UUID -o value "$ESP") /boot/efi vfat umask=0077 0 2"
} > "$MOUNT/etc/fstab"

# fresh machine-id per install (regenerated by systemd).
rm -f "$MOUNT/etc/machine-id"
touch "$MOUNT/etc/machine-id"

# ── environment file: session secret + DB path ──
echo "── Generating secrets…"
SESSION_SECRET=$(openssl rand -hex 32)
mkdir -p "$MOUNT/var/lib/network-monitor"
{
  echo "SESSION_SECRET=$SESSION_SECRET"
  echo "DB_PATH=/var/lib/network-monitor/monitoring.db"
} > "$MOUNT/var/lib/network-monitor/env"
chroot "$MOUNT" chown -R netmon:netmon /var/lib/network-monitor

# ── GRUB (BIOS + UEFI) ──
echo "── Installing GRUB…"
if [ "$IS_UEFI" = yes ]; then
  chroot "$MOUNT" grub-install --target=x86_64-efi \
    --efi-directory=/boot/efi --bootloader-id=NetworkMonitor \
    --recheck --no-nvram
else
  chroot "$MOUNT" grub-install --target=i386-pc "$DISK" --recheck
fi
chroot "$MOUNT" update-grub >/dev/null 2>&1 || chroot "$MOUNT" update-grub

# ── enable services on the installed system ──
chroot "$MOUNT" systemctl enable network-monitor.service nm-console.service nginx nftables 2>/dev/null || true

# ── admin account: the admin chooses the password (empty = auto-generate) ──
echo
echo "── Admin account ──"
PASS_CHOSEN=0
read -rs -p "Choose admin password (empty = auto-generate): " ADMIN_PASS
echo
if [ -n "$ADMIN_PASS" ]; then
  read -rs -p "Confirm password: " ADMIN_PASS2
  echo
  if [ "$ADMIN_PASS" != "$ADMIN_PASS2" ]; then
    warn "  Passwords do not match — an auto-generated password will be used."
    ADMIN_PASS=""
  elif [ "${#ADMIN_PASS}" -lt 4 ]; then
    warn "  Too short (minimum 4 characters) — an auto-generated password will be used."
    ADMIN_PASS=""
  else
    PASS_CHOSEN=1
  fi
fi
[ -z "$ADMIN_PASS" ] && ADMIN_PASS=$(openssl rand -base64 12 | tr -d '/+=' | cut -c1-12)
echo "── Creating admin account…"

# Console gate: store a SHA-512 hash of the SAME password (root-only file).
# The console menu will require it at every boot — one credential, two doors.
printf 'CONSOLE_HASH=%s\n' "$(printf '%s' "$ADMIN_PASS" | sha512sum | cut -d' ' -f1)" > "$MOUNT/etc/nm-console.conf"
chmod 600 "$MOUNT/etc/nm-console.conf"

# Linux admin user for SSH + sudo (same password as web/console).
chroot "$MOUNT" useradd -m -s /bin/bash -G sudo sysadmin 2>/dev/null || true
echo "sysadmin:$ADMIN_PASS" | chroot "$MOUNT" chpasswd >/dev/null 2>&1
chroot "$MOUNT" /usr/bin/env \
  DEFAULT_ADMIN_USERNAME=admin \
  DEFAULT_ADMIN_PASSWORD="$ADMIN_PASS" \
  DB_PATH=/var/lib/network-monitor/monitoring.db \
  /usr/bin/node /opt/network-monitor/backend/src/seedAdmin.js

# ── first-login credentials file (target still mounted!) ──
IP=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
PORT=80
if [ "$NET_MODE" = "static" ]; then DISPLAY_IP="$NET_IP"; else DISPLAY_IP="${IP:-<device-ip>}"; fi
if [ "$PASS_CHOSEN" = 1 ]; then PASS_LINE="(the password you chose during installation)"; else PASS_LINE="$ADMIN_PASS"; fi

cat > "$MOUNT/var/lib/network-monitor/FIRST-LOGIN.txt" << EOF
Network Monitor Appliance — login credentials
====================================================
URL      : http://${DISPLAY_IP}:${PORT}/
Username : admin
Password : ${PASS_LINE}
====================================================
NOTE: change the password (Profile -> change password),
  then delete this file: rm /var/lib/network-monitor/FIRST-LOGIN.txt
EOF
chroot "$MOUNT" chown -R netmon:netmon /var/lib/network-monitor

# ── network config for the installed system — live-boot brings the network
# up only in live mode; the installed system needs its own config.
{
  echo "auto lo"
  echo "iface lo inet loopback"
  for NIC in $(ls /sys/class/net 2>/dev/null | grep -v '^lo$'); do
    echo ""
    echo "auto $NIC"
    if [ "$NET_MODE" = "static" ]; then
      echo "iface $NIC inet static"
      echo "    address $NET_IP"
      echo "    netmask $(prefix2mask "$NET_PREFIX")"
      echo "    gateway $NET_GW"
    else
      echo "iface $NIC inet dhcp"
    fi
  done
} > "$MOUNT/etc/network/interfaces"
if [ "$NET_MODE" = "static" ]; then
  echo "nameserver $NET_DNS" > "$MOUNT/etc/resolv.conf"
fi

# ── cleanup ──
umount -R "$MOUNT/dev" "$MOUNT/proc" "$MOUNT/sys" "$MOUNT/run" 2>/dev/null || true
[ "$IS_UEFI" = yes ] && umount "$MOUNT/boot/efi" 2>/dev/null || true
touch "$MOUNT/etc/nm-installed"
umount -R "$MOUNT"
touch "$MARKER"

printf '\a'
echo
echo "  ═════════════════════════════════════════════════════════"
echo "     [OK] Network Monitor Appliance installed successfully"
echo "  ═════════════════════════════════════════════════════════"
echo
echo "     Web UI  :  http://${DISPLAY_IP}"
echo "     Port    :  ${PORT} (HTTP)"
echo "     Username:  admin"
if [ "$PASS_CHOSEN" = 1 ]; then
  echo "     Password:  (the one you chose during installation)"
else
  echo "     Password:  ${ADMIN_PASS}"
fi
echo
echo "  ─────────────────────────────────────────────────────────"
echo "     WARNING: write the password down — it is NOT shown again"
echo "     Also saved to: /var/lib/network-monitor/FIRST-LOGIN.txt"
echo "  ─────────────────────────────────────────────────────────"
echo
echo "  Note: if the IP changes after reboot, check the console menu."
echo
read -r -p "Reboot now? (y/n): " REBOOT
[ "$REBOOT" = "y" ] && reboot

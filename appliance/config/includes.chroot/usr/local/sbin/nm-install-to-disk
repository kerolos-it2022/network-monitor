#!/bin/bash
# ═══════════════════════════════════════════════════════════════════
# nm-install-to-disk — مثبّت appliance: ينسخ النظام الحي إلى قرص دائم
# ويُثبّت GRUB ويولّد أسرار التشغيل — زي مثبّت أنظمة الجدران النارية.
# ═══════════════════════════════════════════════════════════════════
# تحذير: يمسح القرص الهدف بالكامل. يعمل تفاعليًّا بطلب تأكيد كتابي "YES".
set -euo pipefail

MOUNT=/mnt/nm-install
MARKER=/etc/nm-installed

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*"; }
die()   { printf '\033[31mخطأ: %s\033[0m\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "يجب التشغيل كـ root"
[ -f "$MARKER" ] && die "النظام مثبَّت مسبقًا على هذا الجهاز."

# ── عرض الأقراص المتاحة ──
echo
bold "═══ مثبّت نظام مراقبة الشبكة (appliance) ═══"
echo
echo "الأقراص المتاحة:"
lsblk -dn -o NAME,SIZE,MODEL,TYPE -e 7,11 | awk '{printf "  /dev/%-8s %8s  %s\n", $1, $2, $3}'
echo

# ── اختيار القرص ──
read -r -p "اكتب اسم القرص المراد التثبيت عليه (مثلاً: sda): " DISK_NAME
DISK="/dev/$DISK_NAME"
[ -b "$DISK" ] || die "القرص $DISK غير موجود."

SIZE=$(lsblk -dn -o SIZE -e 7,11 "/dev/$DISK_NAME" | head -1)
MODEL=$(lsblk -dn -o MODEL -e 7,11 "/dev/$DISK_NAME" | head -1)
echo
warn "═══ تحذير نهائي ═══"
warn "سيتم مسح كل بيانات القرص: $DISK ($SIZE — $MODEL)"
read -r -p "للتأكيد اكتب YES بالأحرف الكبيرة: " CONFIRM
[ "$CONFIRM" = "YES" ] || die "أُلغي التثبيت."

# ── تقسيم القرص (GPT — يدعم BIOS وUEFI) ──
echo "── تقسيم القرص…"
umount -R "$MOUNT" 2>/dev/null || true
for p in "$DISK"?*; do umount "$p" 2>/dev/null || true; done
swapoff -a 2>/dev/null || true
wipefs -a "$DISK" >/dev/null 2>&1 || true

IS_UEFI=no
[ -d /sys/firmware/efi ] && IS_UEFI=yes

parted -s "$DISK" mklabel gpt
if [ "$IS_UEFI" = yes ]; then
  parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
  parted -s "$DISK" set 1 esp on
  parted -s "$DISK" mkpart root ext4 513MiB 100%
  ESP="$DISK"1
  ROOT="$DISK"2
  mkfs.vfat -F32 "$ESP" >/dev/null
else
  parted -s "$DISK" mkpart bios_grub 1MiB 2MiB
  parted -s "$DISK" set 1 bios_grub on
  parted -s "$DISK" mkpart root ext4 2MiB 100%
  ROOT="$DISK"2
fi
mkfs.ext4 -F -L nmroot "$ROOT" >/dev/null

# ── نسخ النظام ──
echo "── نسخ النظام إلى القرص (قد يستغرق دقائق)…"
mkdir -p "$MOUNT"
mount "$ROOT" "$MOUNT"
[ "$IS_UEFI" = yes ] && { mkdir -p "$MOUNT/boot/efi"; mount "$ESP" "$MOUNT/boot/efi"; }

rsync -aHAX --info=progress2 \
  --exclude=/dev --exclude=/proc --exclude=/sys --exclude=/run \
  --exclude=/live --exclude=/media --exclude=/mnt --exclude=/tmp \
  --exclude=/swapfile --exclude=/etc/nm-installed \
  / "$MOUNT/"
chmod 1777 "$MOUNT/tmp"

# ── تحضير chroot ──
mount --bind /dev  "$MOUNT/dev"
mount --bind /proc "$MOUNT/proc"
mount --bind /sys  "$MOUNT/sys"
mount --bind /run  "$MOUNT/run"

# ── fstab من UUIDs الفعلية ──
ROOT_UUID=$(blkid -s UUID -o value "$ROOT")
{
  echo "UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1"
  [ "$IS_UEFI" = yes ] && echo "UUID=$(blkid -s UUID -o value "$ESP") /boot/efi vfat umask=0077 0 2"
} > "$MOUNT/etc/fstab"

# machine-id جديد لكل تثبيت (يُعيد systemd توليده).
rm -f "$MOUNT/etc/machine-id"
touch "$MOUNT/etc/machine-id"

# ── ملف البيئة: سر الجلسة + مسار قاعدة البيانات ──
echo "── توليد أسرار التشغيل…"
SESSION_SECRET=$(openssl rand -hex 32)
mkdir -p "$MOUNT/var/lib/network-monitor"
{
  echo "SESSION_SECRET=$SESSION_SECRET"
  echo "DB_PATH=/var/lib/network-monitor/monitoring.db"
} > "$MOUNT/var/lib/network-monitor/env"
chroot "$MOUNT" chown netmon:netmon /var/lib/network-monitor/env

# ── GRUB (يدعم BIOS وUEFI) ──
echo "── تثبيت محمّل الإقلاع GRUB…"
if [ "$IS_UEFI" = yes ]; then
  chroot "$MOUNT" grub-install --target=x86_64-efi \
    --efi-directory=/boot/efi --bootloader-id=NetworkMonitor \
    --recheck --no-nvram
else
  chroot "$MOUNT" grub-install --target=i386-pc "$DISK" --recheck
fi
chroot "$MOUNT" update-grub >/dev/null 2>&1 || chroot "$MOUNT" update-grub

# ── تفعيل الخدمات على النظام المثبَّت ──
chroot "$MOUNT" systemctl enable network-monitor.service nm-console.service nginx nftables 2>/dev/null || true

# ── حساب الأدمن: توليد كلمة مرور عشوائية وإنشاؤها في قاعدة البيانات ──
echo "── إنشاء حساب المدير…"
ADMIN_PASS=$(openssl rand -base64 12 | tr -d '/+=' | cut -c1-12)
chroot "$MOUNT" /usr/bin/env \
  DEFAULT_ADMIN_USERNAME=admin \
  DEFAULT_ADMIN_PASSWORD="$ADMIN_PASS" \
  DB_PATH=/var/lib/network-monitor/monitoring.db \
  /usr/bin/node /opt/network-monitor/backend/src/seedAdmin.js

# ── ملخص نهائي (إشعار نهاية التنصيب) ──
IP=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
PORT=80

# حفظ نسخة من بيانات الدخول على النظام المثبَّت (قابلة للاسترجاع من الكونسول):
#   cat /var/lib/network-monitor/FIRST-LOGIN.txt
cat > "$MOUNT/var/lib/network-monitor/FIRST-LOGIN.txt" << EOF
Network Monitor Appliance — بيانات الدخول الأولى
=================================================
العنوان:       http://${IP:-<IP-الجهاز>}:${PORT}/
اسم المستخدم:  admin
كلمة المرور:   ${ADMIN_PASS}
=================================================
⚠️ غيّر كلمة المرور فورًا من: الملف الشخصي ← تغيير كلمة المرور
   وبعد التغيير احذف هذا الملف:  rm /var/lib/network-monitor/FIRST-LOGIN.txt
EOF
chroot "$MOUNT" chown netmon:netmon /var/lib/network-monitor/FIRST-LOGIN.txt

umount -R "$MOUNT/dev" "$MOUNT/proc" "$MOUNT/sys" "$MOUNT/run" 2>/dev/null || true
[ "$IS_UEFI" = yes ] && umount "$MOUNT/boot/efi" 2>/dev/null || true
umount -R "$MOUNT"
touch "$MARKER"

# شاشة الإشعار النهائية — بارزة بكل بيانات الدخول (بلا حدود يمينية لِثبات العرض مع العربية).
printf '\a'
echo
echo "  ═════════════════════════════════════════════════════════"
echo "     ✅  اكتمل تثبيت Network Monitor Appliance بنجاح"
echo "  ═════════════════════════════════════════════════════════"
echo
echo "     🌐  عنوان الوصول :  http://${IP:-<IP-الجهاز>}:${PORT}"
echo "     🔌  البورت       :  ${PORT} (HTTP)"
echo "     👤  اسم المستخدم :  admin"
echo "     🔑  كلمة المرور  :  ${ADMIN_PASS}"
echo
echo "  ─────────────────────────────────────────────────────────"
echo "     ⚠️  سجّل كلمة المرور الآن — لن تُعرض مرة أخرى"
echo "     📄  نسخة محفوظة: /var/lib/network-monitor/FIRST-LOGIN.txt"
echo "  ─────────────────────────────────────────────────────────"
echo
echo "  ملاحظة: لو تغيّر IP بعد إعادة التشغيل، اعرضه من الكونسول مباشرة."
echo
read -r -p "إعادة التشغيل الآن؟ (y/n): " REBOOT
[ "$REBOOT" = "y" ] && reboot

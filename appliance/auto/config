#!/bin/sh
# auto/config — تكوين live-build: دبيان 12 (bookworm) amd64 — ISO هجين BIOS/UEFI.
# يُستدعى تلقائيًّا من lb build (شرط الاسم auto/config).
set -e

lb config noauto \
    --mode debian \
    --architecture amd64 \
    --distribution bookworm \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap http://deb.debian.org/debian \
    --mirror-binary http://deb.debian.org/debian \
    --mirror-debian-installer http://deb.debian.org/debian \
    --debian-installer none \
    --system live \
    --iso-volume "NetworkMonitor" \
    --iso-application "Network Monitor Appliance" \
    --bootappend-live "boot=live components quiet" \
    --apt-recommends false \
    --security false \
    "${@}"
